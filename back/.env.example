# Copy this file to .env, in this folder, and fill in the empty values.
# .env is not versioned: it holds the secrets of your installation.
# Spring Boot and Docker Compose both read it.

# Database that Docker Compose creates on its first start
DB_NAME=yoga
DB_USER=yoga
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Key that signs the tokens: at least 64 random bytes, encoded in Base64. To generate one:
# node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
TOKEN_SECRET=
